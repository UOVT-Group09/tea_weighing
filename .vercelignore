# Files the Vercel CLI must not upload.
#
# NOTE: src/chatbot/knowledge/*.md MUST ship — rag.py globs that directory at
# runtime to build the BM25 index. Never add it here (same rule as
# .dockerignore). The bundle-level trimming lives in vercel.json's
# "excludeFiles"; this file governs the upload itself.
.git
.github
.venv
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
.env
.env.*
!.env.example
*.local.env
*.log
tea.db
.vscode/
.idea/
